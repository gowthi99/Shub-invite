# Neon Postgres (auto-set when you add Neon from the Vercel Marketplace). Leave unset locally to use an embedded PGlite DB in ./.pglite
DATABASE_URL=
# Random 32+ char string used to sign login sessions
AUTH_SECRET=
# Vercel Blob token (auto-set when you add a Blob store). Leave unset locally to save uploads to public/uploads
BLOB_READ_WRITE_TOKEN=
# Public base URL used in share links / OG tags, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=
